# CoreStone Technologies — Backend Environment Variables
# Copy to .env for local development. In production these are set as
# platform environment variables (Render / Oracle Cloud VM), never committed.

PROJECT_NAME="CoreStone Technologies API"
ENVIRONMENT=development
DEBUG=true

# Comma-separated list of allowed frontend origins
BACKEND_CORS_ORIGINS_RAW=http://localhost:5173,http://127.0.0.1:5173

# --- Security ---
SECRET_KEY=replace-with-a-long-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Database Configuration (Supabase PostgreSQL / Oracle) ---
# For Supabase PostgreSQL (Managed Production DB):
DATABASE_URL=postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Legacy Oracle fallback (if DATABASE_URL is not set):
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10

# --- Email Notifications (Resend HTTPS API / Gmail SMTP) ---
# Resend HTTPS API (Recommended for Render — port 443 HTTPS never blocked):
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Legacy Gmail SMTP (Local dev fallback):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL=corestonetech2026@gmail.com

ADMIN_DEFAULT_EMAIL=corestonetech2026@gmail.com
LOG_LEVEL=INFO
