# CoreStone Technologies — Backend Environment Variables
# Copy to .env for local development. In production these are set as
# platform environment variables (Render / Oracle Cloud VM), never committed.

PROJECT_NAME="CoreStone Technologies API"
ENVIRONMENT=development
DEBUG=true

# Comma-separated list of allowed frontend origins
BACKEND_CORS_ORIGINS_RAW=http://localhost:5173,http://127.0.0.1:5173

# --- Security ---
SECRET_KEY=replace-with-a-long-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Oracle Database ---
# Oracle Database is the ONLY supported database — there is no SQLite,
# PostgreSQL, or MySQL fallback. Leaving these blank means any route that
# touches the database (i.e. everything except /health) fails loudly with
# a clear OracleConfigurationError instead of silently using another DB.
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10

# --- WhatsApp Business API ---
WHATSAPP_BUSINESS_NUMBER=917708196424
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

ADMIN_DEFAULT_EMAIL=corestonetech2026@gmail.com
LOG_LEVEL=INFO
