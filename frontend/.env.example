# CoreStone Technologies — Frontend Environment Variables
# Copy this file to .env for local development, and configure the same
# keys in Vercel Project Settings for deployment.

# Base URL of the FastAPI backend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Public contact details (also duplicated in src/data/site.js for build-time use)
VITE_WHATSAPP_NUMBER=917708196424
VITE_CONTACT_EMAIL=corestonetech2026@gmail.com
VITE_CONTACT_PHONE=+917708196424

# Google Maps embed (Contact page placeholder pin)
VITE_GOOGLE_MAPS_EMBED_SRC=

# Analytics (optional, leave blank to disable)
VITE_GA_MEASUREMENT_ID=
